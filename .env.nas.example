# NAS 部署示例。复制为 .env 后修改路径：
#   cp .env.nas.example .env

APP_VERSION=1.2.3

# 宿主机目录：请换成 NAS 上的真实绝对路径。
# 飞牛示例：/vol1/1000/docker/music-monitor/config
# 群晖示例：/volume1/docker/music-monitor/config
CONFIG_DIR=/volume1/docker/music-monitor/config
MUSIC_DIR=/volume1/music

# 容器写文件时使用的 UID/GID，必须对上面两个目录有读写权限。
PUID=1000
PGID=1000

MONITOR_PORT=9090
TZ=Asia/Shanghai

# 下载默认值，之后也可以在网页中调整。
DOWNLOAD_CONCURRENCY=1
DOWNLOAD_RETRIES=2
DOWNLOAD_BATCH=8
DOWNLOAD_BATCH_GAP=3
DOWNLOAD_TIMEOUT=300
DEFAULT_QUALITY=master
LX_PLATFORM_PRIORITY=tx,kg,kw,mg,wy
LX_QUALITY_FLOOR=128k
LX_SEARCH_LIMIT=30
LX_MATCH_THRESHOLD=0.76
DOWNLOAD_ARTIST_DIR=true

# 两项均可留空。留空时 LX 仅在 Compose 内网开放；平台凭据主密钥会在
# CONFIG_DIR/monitor/.credentials.key 自动生成，请务必随 config 一起备份。
LX_GATEWAY_TOKEN=
CREDENTIALS_MASTER_KEY=
