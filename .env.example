# 复制为 .env 后按需修改，全部可留空使用默认值

# ── 版本 ────────────────────────────────────────────────────────────────────
# 当前使用的版本号。这是宿主机侧唯一的版本变量：
#   · 三个服务的镜像 tag 默认跟随它 → 拉 yua0712/music-monitor-lx 对应标签
#   · 需要回滚时，把它改成旧版本号（如 1.0.0）再 pull 即可
#
# ⚠️ 不要手改数字 —— 用 scripts/version.sh bump 统一改，它会同步代码里的 __version__、
#    Dockerfile、CHANGELOG 并打 git tag，避免「代码版本和镜像版本对不上」。
#    校验是否一致： ./scripts/version.sh check
APP_VERSION=1.2.2

# ── 镜像地址（可选，一般不用改）──────────────────────────────────────────────
# 留空 = 自动使用 yua0712/music-monitor-lx:v<APP_VERSION>（推荐，改版本号就自动跟随）。
# 需要换仓库、或坚持固定用 latest 时，取消下面这行注释并改成你的地址；
# 一旦设置，就会覆盖上面的版本派生规则。
#
# 其它仓库示例（第一段是命名空间 / 你的 Docker ID）：
#   阿里云 ACR     registry.cn-hangzhou.aliyuncs.com/yournamespace/music-monitor:v1.0.0
#   腾讯云 TCR     ccr.ccs.tencentyun.com/yournamespace/music-monitor:v1.0.0
#   私有 registry  192.168.1.10:5000/music-monitor:v1.0.0
#   本地构建        music-monitor:latest    （配合 docker compose up -d --build）
#
# ⚠️ 国内直连 Docker Hub 常超时，拉取需要配镜像加速，见 docs/deploy.md。
# 三个服务默认从同一个 Docker Hub 项目的不同标签拉取：
#   yua0712/music-monitor-lx:v<版本>
#   yua0712/music-monitor-lx:lx-gateway-v<版本>
#   yua0712/music-monitor-lx:platform-auth-v<版本>
# 如需覆盖，可分别设置：
# MONITOR_IMAGE=yua0712/music-monitor-lx:latest
# LX_GATEWAY_IMAGE=yua0712/music-monitor-lx:lx-gateway
# PLATFORM_AUTH_IMAGE=yua0712/music-monitor-lx:platform-auth

# ── 构建期源加速（国内构建强烈建议打开）────────────────────────────────────
# ⚠️ 这里只管「构建过程」用的源，和拉基础镜像不是一回事：
#    · 拉 python/node/golang 基础镜像走 Docker 守护进程的 registry-mirrors
#      （Docker Hub 在国内经常直接超时，必须配，见 docs/deploy.md「国内网络注意事项」）
#    · 下面两项管的是构建容器内部的 apt 和 pip
#
# APT_MIRROR  替换 Debian 软件源，留空用官方源。常用：mirrors.aliyun.com
# PIP_INDEX   替换 PyPI 源，留空用官方源。常用：https://pypi.tuna.tsinghua.edu.cn/simple
#
# 在国内 NAS 上就地构建时，把下面两行填上：
APT_MIRROR=
PIP_INDEX=

# ── 宿主机路径（只需要这两个）─────────────────────────────────────────────
# CONFIG_DIR：全部配置和运行状态。服务会在下面使用 monitor/、users/、lx/、lx-sources/。
# MUSIC_DIR：音乐库根目录。LX 网关可写，monitor 只读。
# 宿主机真实路径只在 Compose 配置；网页只能选择 MUSIC_DIR 下的相对子目录。
CONFIG_DIR=./config
MUSIC_DIR=./data/downloads

# ── 端口与行为 ──────────────────────────────────────────────────────────────
# 宿主机映射端口
MONITOR_PORT=9090         # 本项目监控控制台端口

# 调度器心跳（秒）：越大越省资源，越小发现新歌越快
TICK_SECONDS=60

# 并发下载数：默认 1，逐首等待上游结果，避免一次提交整批任务
DOWNLOAD_CONCURRENCY=1

# 单首下载失败后的重试次数
DOWNLOAD_RETRIES=2

# ── 分批推送（推荐保持默认）─────────────────────────────────────────────────
# 一轮任务不会把整份清单一次性灌给引擎，而是「推一批 → 等这批全部落盘 → 再推下一批」。
# 好处：上游不会积压、日志两边数得清、某首卡住也不会拖住后面的批次。
#
# DOWNLOAD_BATCH      每批推送多少首（默认 8）
# DOWNLOAD_BATCH_GAP  两批之间歇多少秒（默认 3）
# DOWNLOAD_TIMEOUT    单个下载请求的超时秒数（默认 300）
#                     无损单曲 30~80MB，上游要写完盘才回包；这个值设太小会误判失败后重推，
#                     引擎侧同一条下载就被记成两次，两头数量永远对不上。
DOWNLOAD_BATCH=8
DOWNLOAD_BATCH_GAP=3
DOWNLOAD_TIMEOUT=300

# 每轮任务的硬上限（0 = 不限，由每个监控自己的「单次最多下载」决定）
# 保持 0 即可，免得两个上限叠在一起、日志里看不出到底被哪个卡住。
MAX_DOWNLOADS_PER_RUN=0

# 默认目标音质：master | atmos_plus | atmos | hires | flac24bit | lossless | high | standard
#   standard  ≈ 128kbps
#   high      ≈ 320kbps
#   lossless  ≈ FLAC 无损（需要对应平台会员 Cookie，否则会降级）
#   hires     ≈ Hi-Res 24bit（绝大多数情况无法满足，会自动降级）
DEFAULT_QUALITY=master

# ── LX 音源下载后端 ────────────────────────────────────────────────────────
# 把 LX Music 自定义音源 .js 文件放在该目录。音源脚本通常包含私有 key，目录内容不会进 Git。
# LX 平台搜索顺序。QQ 曲库较全，放第一；网易云试听源较多，放最后。
LX_PLATFORM_PRIORITY=tx,kg,kw,mg,wy

# 自动降级最低允许档：master|atmos_plus|atmos|hires|flac24bit|flac|320k|128k
LX_QUALITY_FLOOR=128k
LX_SEARCH_LIMIT=30
LX_MATCH_THRESHOLD=0.76

# 可选：Compose 内网通常可留空；若把 8090 暴露到宿主机，必须设置随机长 token。
LX_GATEWAY_TOKEN=
DOWNLOAD_ARTIST_DIR=true

# 可选：平台 Cookie 加密主密钥。生产环境建议用 `Fernet.generate_key()` 生成并通过 Docker secret 注入。
# 留空时首次启动会在 CONFIG_DIR/monitor/.credentials.key 自动生成，只适合单机部署。
CREDENTIALS_MASTER_KEY=

# 时区
TZ=Asia/Shanghai
